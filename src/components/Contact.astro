---
import Icon from "./Icon.astro";
import Booking from "./Booking.tsx";
import Logo from "./Logo.astro";
import { CONTACT } from "../lib/brand";
const direct = [
  { icon: "whatsapp", label: "WhatsApp", value: CONTACT.phoneDisplay, href: `https://wa.me/${CONTACT.whatsapp}`, ext: true },
  { icon: "envelope", label: "Email", value: CONTACT.email, href: `mailto:${CONTACT.email}`, ext: false },
  { icon: "instagram", label: "Instagram", value: CONTACT.instagramHandle, href: CONTACT.instagram, ext: true },
] as const;
const actions = [
  { icon: "phone", label: `Call ${CONTACT.phoneDisplay}`, href: CONTACT.phoneHref },
  { icon: "whatsapp", label: "Message on WhatsApp", href: `https://wa.me/${CONTACT.whatsapp}` },
  { icon: "envelope", label: `Email ${CONTACT.email}`, href: `mailto:${CONTACT.email}` },
  { icon: "instagram", label: "Instagram", href: CONTACT.instagram },
] as const;
---
<section id="book" class="cv py-24 md:py-36">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="rv lg:col-span-5">
      <h2 class="h2 text-[clamp(2.3rem,4.3vw,4.25rem)]">Tell us what you’re building</h2>
      <p class="lede mt-6">Pick a day and a time. Your request opens in WhatsApp, and we confirm the call there.</p>
      <ul class="mt-10 grid gap-1 border-t border-line pt-4">
        {direct.map((d) => (
          <li>
            <a href={d.href} target={d.ext ? "_blank" : undefined} rel={d.ext ? "noopener noreferrer" : undefined} class="group flex items-center gap-4 rounded-2xl py-3 transition-colors">
              <span class="grid size-12 shrink-0 place-items-center rounded-full bg-surface transition-colors duration-300 group-hover:bg-accent group-hover:text-on-accent"><Icon name={d.icon} class="size-5" /></span>
              <span class="min-w-0">
                <span class="block text-sm text-muted">{d.label}</span>
                <span class="block truncate text-[1.05rem] font-medium">{d.value}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="lg:col-span-7">
      <div class="bezel">
        <div class="bezel-core">
          <Booking client:visible />
        </div>
      </div>
    </div>
  </div>
</section>

<section id="contact" class="cv pb-24 md:pb-36">
  <div class="wrap">
    <h2 class="h2 rv">Visit the studio</h2>
    <div class="rv bezel mt-12 md:mt-16">
      <div class="bezel-core map-shell relative overflow-hidden" data-map>
        <div class="map-frame lattice relative h-[min(74vh,640px)] min-h-[380px] overflow-hidden">
          <iframe
            data-map-iframe
            data-explore-src={CONTACT.mapsEmbedExplore}
            data-styled-src={CONTACT.mapsEmbed}
            title="Map of G-11 Markaz, Islamabad, where Hashbrown Studios is based"
            src={CONTACT.mapsEmbed}
            loading="lazy"
            tabindex="-1"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 size-full border-0"></iframe>
          <div class="map-tint" aria-hidden="true"></div>
          <div class="map-pin" aria-hidden="true">
            <span class="pin-pulse"></span><span class="pin-pulse"></span>
            <span class="pin-head"><img src="/favicon.svg" alt="" width="34" height="34" /></span>
            <span class="pin-label">Hashbrown Studios</span>
          </div>
          <button type="button" data-map-explore aria-pressed="false" class="map-explore">
            <Icon name="map-trifold" class="size-[1.1rem]" /><span data-map-explore-label>Explore map</span>
          </button>
        </div>

        <div class="map-card">
          <div class="flex items-center gap-3">
            <Logo id="map-logo" class="size-11 shrink-0" />
            <div class="leading-tight">
              <p class="font-bold tracking-[-0.01em] [font-stretch:115%]">Hashbrown Studios</p>
              <p class="text-sm text-muted">Web design and development</p>
            </div>
          </div>
          <address class="mt-6 text-[clamp(1.5rem,2.2vw,1.9rem)] font-bold not-italic leading-[1.05] tracking-[-0.025em] [font-stretch:118%]">G-11 Markaz,<br />Islamabad, Pakistan</address>
          <p class="mt-3 text-muted">Visits by appointment, so message us before you come over.</p>
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <a href={CONTACT.directions} target="_blank" rel="noopener" class="btn btn-primary btn-sm magnetic">
              <span>Get directions</span><span class="btn-ico"><Icon name="arrow-up-right" /></span>
            </a>
            {actions.map((a) => (
              <a href={a.href} target={a.href.startsWith("http") ? "_blank" : undefined} rel={a.href.startsWith("http") ? "noopener" : undefined} aria-label={a.label} class="map-action">
                <Icon name={a.icon} class="size-5" />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
