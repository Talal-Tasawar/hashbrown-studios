---
import { CONTACT } from "../lib/brand";

// Visible questions and the FAQPage schema are built from the same list, so they never drift apart.
const faqs = [
  {
    q: "How much does a website cost?",
    a: "It depends on how many pages and features you need. Book a short call, tell us what you have in mind, and you get a fixed quote before any work starts.",
  },
  {
    q: "How long does it take to build a website?",
    a: "Most websites go live within 7 days of our first call. We agree on the launch date before work starts, so you know exactly when to expect it.",
  },
  {
    q: "Do you only work with businesses in Islamabad?",
    a: "No. The studio is in G-11 Markaz, Islamabad, and we have launched sites for businesses in Islamabad, Rawalpindi and Karachi. Calls and reviews happen over WhatsApp and video, so location is never a problem.",
  },
  {
    q: "What kind of websites do you build?",
    a: "Landing pages, online stores, and business sites with booking forms and maps. Recent projects include car detailing studios, a car wrap shop, a car care store and an NFC review card brand.",
  },
  {
    q: "Will my website show up on Google?",
    a: "Every site we launch is fast, mobile friendly and set up for search, with page titles, meta descriptions, structured data, a sitemap and Google Search Console. Rankings take time, but your site starts on solid ground.",
  },
  {
    q: "How do I get started?",
    a: `Use the booking form below to pick a day and time. It opens WhatsApp with your details filled in, and we confirm the call there. You can also message us directly on ${CONTACT.phoneDisplay}.`,
  },
];
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<section id="faq" class="cv py-24 md:py-36">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 class="h2 rv text-[clamp(2.4rem,3.6vw,3.6rem)] lg:sticky lg:top-28">Questions, answered</h2>
    </div>
    <dl class="grid gap-x-10 border-t border-line sm:grid-cols-2 lg:col-span-7">
      {faqs.map((f) => (
        <div class="rv border-b border-line py-8 sm:py-10">
          <dt class="text-[1.3rem] font-bold leading-tight tracking-[-0.02em] [font-stretch:112%]">{f.q}</dt>
          <dd class="mt-3 text-muted">{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
