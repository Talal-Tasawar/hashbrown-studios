---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { BLOB_MASK } from "../lib/brand";
const edges = Array.from({ length: 22 }, (_, i) => i + 1);
const dotEdges = Array.from({ length: 8 }, (_, j) => j + 1);
---
<section class="relative" style="view-timeline-name: --hero">
  <div class="wrap grid min-h-[100dvh] content-center items-center gap-6 pb-14 pt-24 md:grid-cols-12 md:gap-8 md:pb-16">
    <div class="relative z-[1] order-2 md:order-1 md:col-span-7">
      <h1 class="display text-[clamp(3.05rem,7.4vw,8.25rem)]">
        <span class="mb-5 block text-[clamp(0.95rem,1.15vw,1.1rem)] font-semibold leading-snug tracking-normal text-accent-ink [font-stretch:110%] md:mb-7">Hashbrown Studios, web design in Islamabad</span>
        <span class="hero-line block whitespace-nowrap">Websites,</span>
        <span class="hero-line block whitespace-nowrap">made crisp.</span>
      </h1>
      <p class="hero-rise lede mt-6 md:mt-9">We design and build fast, memorable websites for founders and growing brands, from first sketch to launch day.</p>
      <div class="hero-rise mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary magnetic" href="#book"><span>Book a call</span><span class="btn-ico"><Icon name="arrow-up-right" /></span></a>
        <a class="btn btn-ghost magnetic" href="#work"><span>See our work</span><span class="btn-ico"><Icon name="arrow-up-right" /></span></a>
      </div>
    </div>
    <div class="order-1 flex justify-end pr-2 md:order-2 md:col-span-5 md:justify-center md:pr-0">
      <div class="hb-stage" style={`--blob:${BLOB_MASK}`} aria-hidden="true">
        <div class="hb-shadow"></div>
        <div class="hb-scroll">
          <div class="hb-tilt" data-tilt>
            <div class="hb-intro">
              <div class="hb-float">
                <div class="hb-obj">
                  {edges.map((i) => <span class="hb-edge" style={`--i:${i}`}></span>)}
                  <Logo id="hb3d" class="hb-face" dot={false} />
                  <span class="hb-sheen"></span>
                  {dotEdges.map((j) => <span class="hb-dot-edge" style={`--j:${j}`}></span>)}
                  <span class="hb-dot"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
