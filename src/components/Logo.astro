---
// HashBrown Studios logo: italic H whose doubled crossbar runs out as speed lines.
interface Props {
  href?: string;
  class?: string;
}
const { href = "/", class: className = "" } = Astro.props;
---
<a class:list={["hb-logo", className]} href={href} aria-label="HashBrown Studios — home">
  <svg class="hb-logo-mark" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="15" />
    <path d="M20.6 14h7.6l-6.7 36h-7.6z" />
    <path d="M36.4 14H44l-6.7 36h-7.6z" />
    <path class="hb-logo-speed" d="M24.6 26.5H54l-1 4H23.85z" />
    <path class="hb-logo-speed" d="M23.1 34.5H50l-1 4H22.35z" />
  </svg>
  <span class="hb-logo-type">HashBrown<small>Studios</small></span>
</a>
