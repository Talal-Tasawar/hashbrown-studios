---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { CONTACT } from "../lib/brand";
const links = [
  { href: "#work", label: "Work" },
  { href: "#services", label: "Services" },
  { href: "#process", label: "Process" },
  { href: "#studio", label: "Studio" },
  { href: "#contact", label: "Contact" },
];
---
<header data-nav class="fixed inset-x-0 top-0 z-50 flex justify-center px-3 pt-3 md:pt-4">
  <nav aria-label="Primary" class="flex h-[3.75rem] w-full max-w-[1120px] items-center gap-1 rounded-full bg-bg/70 py-2 pl-2 pr-2 shadow-[inset_0_0_0_1px_var(--line),0_20px_50px_-30px_rgb(var(--shadow)/0.6)] backdrop-blur-xl backdrop-saturate-150">
    <a href="#main" class="flex items-center gap-2.5 rounded-full py-1 pl-1.5 pr-3" aria-label="Hashbrown Studios, back to top">
      <Logo id="nav-logo" class="size-9 shrink-0" />
      <span translate="no" class="text-[1.05rem] font-bold tracking-[-0.02em] [font-stretch:118%]">Hashbrown <span class="font-normal text-muted">Studios</span></span>
    </a>
    <ul class="mx-auto hidden items-center lg:flex">
      {links.map((l) => (
        <li><a href={l.href} class="rounded-full px-4 py-2 text-[0.95rem] text-muted transition-colors duration-300 hover:text-ink">{l.label}</a></li>
      ))}
    </ul>
    <button type="button" data-theme-toggle class="ml-auto grid size-11 shrink-0 place-items-center rounded-full text-ink transition-colors hover:bg-ink/5 lg:ml-0" aria-label="Switch between light and dark theme">
      <Icon name="sun" class="icon-sun size-5" />
      <Icon name="moon" class="icon-moon size-5" />
    </button>
    <a href="#book" class="btn btn-primary btn-sm magnetic hidden sm:inline-flex">
      <span>Book a call</span><span class="btn-ico"><Icon name="arrow-up-right" /></span>
    </a>
    <button type="button" data-menu-btn class="burger relative size-11 shrink-0 rounded-full transition-colors hover:bg-ink/5 lg:hidden" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
      <span></span>
      <span></span>
    </button>
  </nav>
</header>

<div id="menu" class="menu fixed inset-0 z-[45] flex flex-col justify-between bg-bg/95 px-6 pb-10 pt-28 backdrop-blur-2xl lg:hidden">
  <ul class="grid gap-1">
    {links.map((l, i) => (
      <li class="overflow-hidden">
        <a href={l.href} data-menu-link class="menu-link display block py-1.5 text-[clamp(2.6rem,12vw,4.5rem)]" style={`--i:${i}`}>{l.label}</a>
      </li>
    ))}
  </ul>
  <div class="menu-link grid gap-4" style="--i:6">
    <a href="#book" data-menu-link class="btn btn-primary w-fit"><span>Book a call</span><span class="btn-ico"><Icon name="arrow-up-right" /></span></a>
    <a href={`mailto:${CONTACT.email}`} class="text-muted underline-offset-4 hover:underline">{CONTACT.email}</a>
  </div>
</div>
