---
import { Picture } from "astro:assets";
import desk from "../assets/work/desk.jpg";
import { siFigma, siAstro, siNextdotjs, siReact, siTailwindcss, siShopify, siWordpress, siWebflow, siCloudflare } from "simple-icons";
const tools = [siFigma, siAstro, siNextdotjs, siReact, siTailwindcss, siShopify, siWordpress, siWebflow, siCloudflare];
const scores = ["Performance", "Accessibility", "Best practices", "SEO"];
const h3 = "text-[1.5rem] font-bold leading-tight tracking-[-0.02em] [font-stretch:115%]";
---
<section id="studio" class="cv py-24 md:py-36">
  <div class="wrap">
    <h2 class="h2 rv max-w-4xl">Small studio, senior hands</h2>
    <div class="mt-12 grid gap-4 md:mt-20 md:grid-cols-12 md:gap-5">
      <article class="rv bezel md:col-span-7 md:row-span-2">
        <div class="bezel-core flex h-full flex-col overflow-hidden">
          <Picture src={desk} alt="A designer's desk with a laptop, notebook and phone" formats={["avif", "webp"]} quality={60} width={1100} widths={[420, 700, 1100]} sizes="(min-width: 768px) 56vw, 92vw" class="aspect-[16/10] w-full object-cover md:aspect-auto md:min-h-[16rem] md:flex-1" loading="lazy" decoding="async" />
          <div class="p-7 md:p-10">
            <h3 class="text-[clamp(1.6rem,2.4vw,2.25rem)] font-bold leading-tight tracking-[-0.025em] [font-stretch:115%]">You work with the people doing the work</h3>
            <p class="mt-3 max-w-[50ch] text-muted">No account managers and no handoffs to juniors. The designers and developers on your first call are the ones who build your site.</p>
          </div>
        </div>
      </article>

      <article class="rv bezel md:col-span-5">
        <div class="bezel-core h-full p-7 md:p-9">
          <ul class="grid grid-cols-4 gap-2">
            {scores.map((s) => (
              <li class="flex flex-col items-center gap-2 text-center">
                <svg viewBox="0 0 40 40" class="size-[clamp(3.5rem,5.5vw,4.75rem)]" aria-hidden="true">
                  <circle cx="20" cy="20" r="18" fill="none" stroke="var(--line)" stroke-width="2.5" />
                  <circle class="ring-fill" cx="20" cy="20" r="18" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="113.1" stroke-dashoffset="0" transform="rotate(-90 20 20)" />
                  <text x="20" y="20.5" text-anchor="middle" dominant-baseline="middle" fill="var(--ink)" font-size="11" font-weight="700">100</text>
                </svg>
                <span class="text-[0.8rem] leading-tight text-muted">{s}</span>
              </li>
            ))}
          </ul>
          <h3 class:list={[h3, "mt-8"]}>Built to score 100</h3>
          <p class="mt-2 text-muted">We aim every build at a perfect Lighthouse score, on mobile and desktop.</p>
        </div>
      </article>

      <article class="rv bezel md:col-span-5">
        <div class="bezel-core lattice flex h-full min-h-[14rem] flex-col justify-end p-7 md:p-9">
          <h3 class={h3}>Yours to edit</h3>
          <p class="mt-2 max-w-[40ch] text-muted">Every site ships with a CMS and a recorded walkthrough, so changing prices or posting news never has to wait for us.</p>
        </div>
      </article>

      <article class="rv rounded-[2rem] bg-accent p-7 text-on-accent md:col-span-5 md:p-9">
        <p class="text-[clamp(4rem,7vw,6.5rem)] font-extrabold leading-[0.85] tracking-[-0.05em] [font-stretch:125%]">7 days</p>
        <p class="mt-4 max-w-[30ch] text-[1.1rem] font-medium">or less, from first call to a live website.</p>
      </article>

      <article class="rv bezel md:col-span-7">
        <div class="bezel-core flex h-full flex-col justify-between gap-8 p-7 md:p-9">
          <h3 class={h3}>Tools we build with</h3>
          <ul class="grid grid-cols-5 items-center gap-x-4 gap-y-6 sm:grid-cols-9">
            {tools.map((t) => (
              <li class="flex justify-center"><svg viewBox="0 0 24 24" class="size-7 fill-ink/80 md:size-8" role="img" aria-label={t.title}><path d={t.path} /></svg></li>
            ))}
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>
