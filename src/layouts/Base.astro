---
import "../styles/global.css";
import { CONTACT } from "../lib/brand";

const title = "Hashbrown Studios | Web Design & Development Agency in Islamabad";
const description =
  "Hashbrown Studios designs and builds fast, memorable websites for founders and growing brands. Web design, development, e-commerce and branding from Islamabad.";
const url = new URL("/", Astro.site).href;
const ogImage = new URL("/og.jpg", Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Hashbrown Studios",
  url,
  image: ogImage,
  description,
  email: CONTACT.email,
  telephone: "+92-364-4915188",
  address: { "@type": "PostalAddress", streetAddress: "G-11 Markaz", addressLocality: "Islamabad", addressCountry: "PK" },
  sameAs: [CONTACT.instagram],
  areaServed: "Worldwide",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#130e09" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbf2e4" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Hashbrown Studios" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo-wdth.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-full focus:bg-accent focus:px-5 focus:py-3 focus:text-on-accent">Skip to content</a>
    <slot />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
