---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import { CONTACT } from "../lib/brand";

const pilot = "https://wa.me/" + CONTACT.whatsapp + "?text=" + encodeURIComponent("Hello HashBrown Studios. I'd like to understand the shared platform and early-access programme.");
const layers = [
  ["01", "Customer website", "A branded public experience for discovering vehicles or services, submitting enquiries, requesting quotes and making eligible bookings."],
  ["02", "Business dashboard", "A private workspace for managing customers, inventory, scheduling, quotes, jobs, staff, payment records and reports."],
  ["03", "Platform administration", "HashBrown's internal tools for provisioning businesses, configuring template entitlements, monitoring usage and supporting tenants."],
];
const shared = [
  "Tenant branding and custom-domain configuration",
  "Customer profiles and enquiry pipeline",
  "Quotes, tasks and operational activity history",
  "Scheduling and resource availability",
  "Media library and controlled file access",
  "Notifications, integrations and reporting",
];
const order = ["Rent-a-Car", "Used Car Showrooms", "Mechanics & Workshops", "Car Detailing Studios"];
---
<Base title="The HashBrown Platform — Shared Automotive Software" description="An overview of the shared platform architecture behind HashBrown's four automotive software templates." path="/platform/">
<div class="hb-site">
  <SiteHeader cta={pilot} />
  <main id="main">
    <section class="hb-shell hb-platform-hero">
      <a class="hb-back" href="/"><Icon name="arrow-left" /> Home</a>
      <p class="hb-eyebrow" data-reveal>The shared platform</p>
      <h1 data-reveal style="--i:1">One platform.<br /><span>Four specialist systems.</span></h1>
      <p class="hb-lede" data-reveal style="--i:2">The common foundation behind each HashBrown automotive template: tenant-branded customer websites, private business dashboards and a shared operational engine.</p>
      <span class="hb-status" data-reveal style="--i:3"><i></i>Planned architecture · Early access</span>
    </section>

    <section class="hb-section hb-section-light">
      <div class="hb-shell">
        <div class="hb-section-heading" data-reveal>
          <div>
            <p class="hb-eyebrow">Three connected layers</p>
            <h2>Built to work<br /><span>as one system.</span></h2>
          </div>
          <p>Each business has its own workspace and customer-facing brand. Shared platform services are maintained centrally; vertical workflows remain specific to the industry.</p>
        </div>
        <div class="hb-layer-list">
          {layers.map(([n, title, text], i) => (
            <article data-reveal style={`--i:${i}`}>
              <span>{n}</span>
              <div><h3>{title}</h3><p>{text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hb-section hb-section-paper">
      <div class="hb-shell hb-platform-shared">
        <div data-reveal>
          <p class="hb-eyebrow">Shared capabilities</p>
          <h2>Build the common parts once.</h2>
          <p>Customer records, permissions, scheduling and notifications should not be rebuilt separately for each template. The rules that make a rental different from a workshop job stay inside their own template modules.</p>
        </div>
        <ul>
          {shared.map((s, i) => <li data-reveal style={`--i:${i}`}><Icon name="plus" />{s}</li>)}
        </ul>
      </div>
    </section>

    <section class="hb-section hb-section-dark">
      <div class="hb-shell hb-workflow-grid">
        <div data-reveal>
          <p class="hb-eyebrow">Delivery order</p>
          <h2>Four templates.<br /><span>Built in sequence.</span></h2>
        </div>
        <ol>
          {order.map((name, i) => <li class="hb-glass-dark" data-reveal style={`--i:${i}`}><span>0{i + 1}</span><b>{name}</b>{i === 0 && <em>First</em>}</li>)}
        </ol>
      </div>
    </section>

    <section class="hb-section hb-section-light">
      <div class="hb-shell hb-scope-note" data-reveal>
        <small>Early access</small>
        <p>The architecture and product scope are still being defined. Operators who join early help decide what the first release does.</p>
        <a class="hb-button hb-button-dark" href={pilot} target="_blank" rel="noopener noreferrer">Discuss a pilot <Icon name="arrow-up-right" /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</div>
</Base>
